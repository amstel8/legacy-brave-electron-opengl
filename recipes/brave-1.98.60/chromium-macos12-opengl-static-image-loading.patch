 PaintImage BitmapImage::PaintImageForCurrentFrameWithInfo(
     const ImageNodeAnimationInfo* image_node_animation_info) {
+#if BUILDFLAG(IS_MAC)
+  static const bool defer_legacy_gl_partial_images =
+      base::CommandLine::ForCurrentProcess()->HasSwitch(
+          "disable-legacy-gl-partial-images");
+  if (defer_legacy_gl_partial_images && !all_data_received_ && decoder_ &&
+      decoder_->RepetitionCount() == kAnimationNone) {
+    const String extension = decoder_->FilenameExtension();
+    if (extension == "jpg" || extension == "webp") {
+      // Completion invalidates the frame cache via DataChanged() and the
+      // normal image notification repaints it. Avoid unstable partial JPEG/WebP
+      // frames on legacy CGL; leave animated images and other formats alone.
+      return PaintImage();
+    }
