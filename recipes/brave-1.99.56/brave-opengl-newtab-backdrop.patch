 void NewTabPageInitializer::AddLoadTimeValues() {
+  // Legacy CGL IOSurface rendering corrupts backdrop-filter passes on some
+  // non-Metal GPUs. Limit the workaround to this WebUI and explicit OpenGL;
+  // compositor/raster acceleration and the default Metal path are retained.
+  bool legacy_opengl = false;
+#if BUILDFLAG(IS_MAC)
+  legacy_opengl = base::CommandLine::ForCurrentProcess()->GetSwitchValueASCII(
+                      "use-angle") == "gl";
+#endif
+  source_->AddString("legacyOpenGL", legacy_opengl ? "true" : "false");
+
   auto* profile = GetProfile();
   auto* prefs = profile->GetPrefs();
 
