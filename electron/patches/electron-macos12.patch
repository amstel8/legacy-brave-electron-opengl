+  auto* command_line = base::CommandLine::ForCurrentProcess();
+  if (!command_line->HasSwitch("type") &&
+      !command_line->HasSwitch("use-angle") &&
+      !command_line->HasSwitch("use-gl") &&
+      !command_line->HasSwitch("disable-gpu")) {
+    @autoreleasepool {
+      id<MTLDevice> device = MTLCreateSystemDefaultDevice();
+      if (!device) {
+        // Non-Metal Macs can retain GPU compositing through ANGLE/CGL.
+        // This switch also selects Ganesh rather than Metal-only Graphite.
+        command_line->AppendSwitchASCII("use-angle", "gl");
